# Backend base URL used by the Next.js server (SSR / route handlers).
API_BASE_URL=http://localhost:3000

# Base URL exposed to the browser for client-side fetches.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# WebSocket endpoint for order tracking.
NEXT_PUBLIC_WS_URL=ws://localhost:3000/ws

# Host that serves the public menu (QR codes / direct links).
NEXT_PUBLIC_MENU_HOST=menu.localhost

# OpenAPI JSON used by `bun run typegen`.
API_DOCS_URL=http://localhost:3000/docs/json
