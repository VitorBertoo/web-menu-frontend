{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "files": {
    "includes": [
      "app/**",
      "lib/**",
      "config/**",
      "components/**",
      "features/**",
      "proxy.ts",
      "next.config.ts",
      "!node_modules",
      "!.next",
      "!next-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 90
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "includes": ["features/menu/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/admin/**", "**/features/admin/**"],
                    "message": "features/menu must not import features/admin. Share code via lib/ or components/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["features/admin/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/menu/**", "**/features/menu/**"],
                    "message": "features/admin must not import features/menu. Share code via lib/ or components/."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
